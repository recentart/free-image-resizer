// Static-assets-only Cloudflare Worker: no server code, it just serves the site's files.
// The site lives in free-image-resizer/public (the repo root only contains that folder).
{
  "name": "free-image-resizer",
  "compatibility_date": "2025-09-24",
  "assets": {
    "directory": "./free-image-resizer/public",
    // Serve 404.html for unknown URLs instead of an empty 404.
    "not_found_handling": "404-page"
  }
}
